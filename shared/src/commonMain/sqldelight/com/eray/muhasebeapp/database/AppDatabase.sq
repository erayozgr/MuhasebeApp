-- ==========================================
-- 1. TABLO TANIMLAMALARI (TÜM TABLOLAR EN ÜSTTE)
-- ==========================================

CREATE TABLE UrunEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    barkod TEXT NOT NULL,
    ad TEXT NOT NULL,
    alisFiyati REAL NOT NULL,
    satisFiyati REAL NOT NULL,
    stokAdedi INTEGER NOT NULL,
    birim TEXT NOT NULL,
    kdvOrani INTEGER NOT NULL
);

CREATE TABLE Musteri (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ad TEXT NOT NULL,
    telefon TEXT NOT NULL,
    adres TEXT NOT NULL,
    bakiye REAL NOT NULL DEFAULT 0.0
);

CREATE TABLE Tedarikci (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ad TEXT NOT NULL,
    telefon TEXT NOT NULL,
    adres TEXT NOT NULL,
    bakiye REAL NOT NULL DEFAULT 0.0
);

CREATE TABLE Satis (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    musteriId INTEGER,
    musteriAdi TEXT NOT NULL,
    tarih TEXT NOT NULL,
    toplamTutar REAL NOT NULL
);

CREATE TABLE SatisKalemi (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    satisId INTEGER NOT NULL,
    urunId INTEGER NOT NULL,
    urunAdi TEXT NOT NULL,
    adet INTEGER NOT NULL,
    birim TEXT NOT NULL DEFAULT 'adet',
    birimFiyat REAL NOT NULL,
    toplam REAL NOT NULL
);

CREATE TABLE Alis (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tedarikciId INTEGER,
    tedarikciAdi TEXT NOT NULL,
    tarih TEXT NOT NULL,
    toplamTutar REAL NOT NULL
);

CREATE TABLE AlisKalemi (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    alisId INTEGER NOT NULL,
    urunId INTEGER NOT NULL,
    urunAdi TEXT NOT NULL,
    adet INTEGER NOT NULL,
    birimFiyat REAL NOT NULL,
    toplam REAL NOT NULL
);

CREATE TABLE Masraf (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kategori TEXT NOT NULL,
    aciklama TEXT NOT NULL,
    tutar REAL NOT NULL,
    tarih TEXT NOT NULL
);

CREATE TABLE StokHareketi (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    urunId INTEGER NOT NULL,
    urunAdi TEXT NOT NULL,
    hareketTuru TEXT NOT NULL,
    miktar INTEGER NOT NULL,
    birimFiyat REAL NOT NULL DEFAULT 0.0,
    aciklama TEXT NOT NULL,
    tarih TEXT NOT NULL
);

-- Müşteriden alınan ödemeleri kronolojik loglamak için eklendi
CREATE TABLE Tahsilat (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    musteriId INTEGER,
    musteriAdi TEXT NOT NULL,
    tutar REAL NOT NULL,
    tarih TEXT NOT NULL
);

-- Tedarikçiye yapılan ödemeleri kronolojik loglamak için eklendi
CREATE TABLE TedarikciOdemesi (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tedarikciId INTEGER,
    tedarikciAdi TEXT NOT NULL,
    tutar REAL NOT NULL,
    tarih TEXT NOT NULL
);

-- ==========================================
-- 2. SORGU TANIMLAMALARI (QUERIES)
-- ==========================================

-- --- Ürün Sorguları ---
selectAllUrun:
SELECT * FROM UrunEntity ORDER BY ad ASC;

insertUrun:
INSERT INTO UrunEntity(barkod, ad, alisFiyati, satisFiyati, stokAdedi, birim, kdvOrani)
VALUES (?, ?, ?, ?, ?, ?, ?);

searchUrun:
SELECT * FROM UrunEntity
WHERE ad LIKE '%' || :aramaMetni || '%' OR barkod LIKE '%' || :aramaMetni || '%'
ORDER BY ad ASC;

updateUrun:
UPDATE UrunEntity
SET barkod = :barkod,
    ad = :ad,
    alisFiyati = :alisFiyati,
    satisFiyati = :satisFiyati,
    stokAdedi = :stokAdedi,
    birim = :birim,
    kdvOrani = :kdvOrani
WHERE id = :id;

deleteUrun:
DELETE FROM UrunEntity WHERE id = :id;

updateUrunStok:
UPDATE UrunEntity SET stokAdedi = :stokAdedi WHERE id = :id;

-- --- Müşteri Sorguları ---
selectAllMusteri:
SELECT * FROM Musteri ORDER BY ad ASC;

insertMusteri:
INSERT INTO Musteri(ad, telefon, adres, bakiye)
VALUES (?, ?, ?, ?);

deleteMusteri:
DELETE FROM Musteri WHERE id = ?;

updateMusteriBakiye:
UPDATE Musteri SET bakiye = ? WHERE id = ?;

selectSatisByMusteriId:
SELECT * FROM Satis WHERE musteriId = :musteriId ORDER BY id DESC;

updateMusteri:
UPDATE Musteri
SET ad = :ad,
    telefon = :telefon,
    adres = :adres
WHERE id = :id;

-- --- Tedarikçi Sorguları ---
selectAllTedarikci:
SELECT * FROM Tedarikci ORDER BY ad ASC;

insertTedarikci:
INSERT INTO Tedarikci(ad, telefon, adres, bakiye)
VALUES (?, ?, ?, ?);

deleteTedarikci:
DELETE FROM Tedarikci WHERE id = ?;

updateTedarikciBakiye:
UPDATE Tedarikci SET bakiye = ? WHERE id = ?;

selectAlisByTedarikciId:
SELECT * FROM Alis WHERE tedarikciId = :tedarikciId ORDER BY id DESC;

updateTedarikci:
UPDATE Tedarikci
SET ad = :ad,
    telefon = :telefon,
    adres = :adres
WHERE id = :id;

-- --- Satış Sorguları ---
selectAllSatis:
SELECT * FROM Satis ORDER BY id DESC;

selectKalemlerBySatisId:
SELECT * FROM SatisKalemi WHERE satisId = :satisId;

insertSatis:
INSERT INTO Satis(musteriId, musteriAdi, tarih, toplamTutar)
VALUES (?, ?, ?, ?);

insertSatisKalemi:
INSERT INTO SatisKalemi(satisId, urunId, urunAdi, adet, birim, birimFiyat, toplam)
VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

-- --- Alış Sorguları ---
selectAllAlis:
SELECT * FROM Alis ORDER BY id DESC;

selectKalemlerByAlisId:
SELECT * FROM AlisKalemi WHERE alisId = :alisId;

insertAlis:
INSERT INTO Alis(tedarikciId, tedarikciAdi, tarih, toplamTutar)
VALUES (?, ?, ?, ?);

insertAlisKalemi:
INSERT INTO AlisKalemi(alisId, urunId, urunAdi, adet, birimFiyat, toplam)
VALUES (?, ?, ?, ?, ?, ?);

lastInsertIdAlis:
SELECT last_insert_rowid();

-- --- Masraf Sorguları ---
selectAllMasraf:
SELECT * FROM Masraf ORDER BY id DESC;

insertMasraf:
INSERT INTO Masraf(kategori, aciklama, tutar, tarih)
VALUES (?, ?, ?, ?);

deleteMasraf:
DELETE FROM Masraf WHERE id = ?;


-- --- Stok Hareketi Sorguları ---
selectAllStokHareketi:
SELECT * FROM StokHareketi ORDER BY id DESC;

insertStokHareketi:
INSERT INTO StokHareketi(urunId, urunAdi, hareketTuru, miktar, birimFiyat, aciklama, tarih)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- --- Tahsilat Sorguları ---
selectAllTahsilat:
SELECT * FROM Tahsilat ORDER BY id DESC;

insertTahsilat:
INSERT INTO Tahsilat(musteriId, musteriAdi, tutar, tarih)
VALUES (?, ?, ?, ?);

deleteTahsilat:
DELETE FROM Tahsilat WHERE id = ?;

-- --- Tedarikçi Ödemesi Sorguları ---
selectAllTedarikciOdemesi:
SELECT * FROM TedarikciOdemesi ORDER BY id DESC;

insertTedarikciOdemesi:
INSERT INTO TedarikciOdemesi(tedarikciId, tedarikciAdi, tutar, tarih)
VALUES (?, ?, ?, ?);

deleteTedarikciOdemesi:
DELETE FROM TedarikciOdemesi WHERE id = ?;